  const numbers = ["0","1","2","3","4","5"];

  for(let i=0;i<40;i++){
      const div = document.createElement("div");
      div.className="slot-number";
      div.textContent = numbers[i % numbers.length];
      reel.appendChild(div);
  }

  const target = Math.floor(finalRating);
  const itemHeight = 60;
